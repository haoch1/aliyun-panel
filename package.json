    "@alicloud/vpc20160428": "7.3.2",
    "@darabonba/typescript": "^1.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
