  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node bin/aliyun-panel.mjs",
    "build": "vite build",
