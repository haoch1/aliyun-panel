# Docker Compose deployment
PANEL_IMAGE=ghcr.io/haoch1/aliyun-panel:latest
PANEL_BIND=127.0.0.1
PANEL_PORT=4182
# Exact public origin when using a reverse proxy, e.g. https://panel.example.com
PUBLIC_ORIGIN=
# Native Node.js deployment only (container settings are defined in compose.yaml)
HOST=127.0.0.1
PORT=4182
DATA_DIR=./data
# Optional Telegram transport proxy; use an address reachable from the server/container.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1
